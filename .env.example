# Comma-separated external sources: audio,notes,bucket. Empty disables every
# external source. GPS compaction and stay detection are internal processing
# stages and still process captures accepted by POST /in. The server still
# serves existing data and accepts HTTP ingestion with every source disabled.
MEDINA_SOURCES=audio,notes,bucket
# Personal lifelog policy belongs in the application configuration, not in
# Medina's reusable modules.
HOME_TZ=UTC
LIFELOG_EPOCH_DAY=1900-01-01
LIFELOG_MAIN_CHANNEL=main
# Public Nominatim asks clients to identify themselves with a valid contact.
# NOMINATIM_USER_AGENT=medina-lifelog/1.0 (you@example.com)
# GOOGLE_TOKEN_URL=https://googlesa-sco-lifelogtest.int.exe.xyz/token
# GDRIVE_FOLDER_ID=...
ASSEMBLYAI_API_URL=https://api.assemblyai.com
# Short context for Universal-3.5 Pro accuracy (2–50 words).
# ASSEMBLYAI_PROMPT=Personal ambient lifelog audio recorded by Scott Raymond, including conversations and spoken notes.
# Optional comma-separated candidates for AssemblyAI Speaker Identification.
# ASSEMBLYAI_SPEAKER_NAMES=Scott Raymond
# ASSEMBLYAI_API_KEY=
JOURNAL_LLM_API_URL=https://api.openai.com/v1
# JOURNAL_LLM_API_KEY=
JOURNAL_LLM_MODEL=gpt-5.5
# The per-batch notes pass is extraction, not writing, and is most of the
# token spend -- give it a cheaper model. Unset = same as JOURNAL_LLM_MODEL.
JOURNAL_LLM_NOTES_MODEL=gpt-5.4-mini
SOURCE_LATEST=10
# DATA_DIR=data/artifacts
# Reads are unauthenticated: bind loopback and put an authenticating front
# door (tailscale serve, the exe.dev proxy, a reverse proxy) in front of it.
# Only set 0.0.0.0 if something else is doing the authenticating.
# HOST=127.0.0.1
PORT=8000
# Read-only MCP bridge (defaults to http://127.0.0.1:$PORT and HOME_TZ):
# LIFELOG_URL=http://127.0.0.1:8000
# LIFELOG_TIME_ZONE=America/Los_Angeles
# Managed checkout under DATA_DIR/sources/git (preferred):
# NOTES_REPO_URL=git@github.com:you/notes.git
# NOTES_REPO_REF=main
# Or use an existing checkout:
# NOTES_REPO_DIR=/absolute/path/to/notes
# S3-compatible recording source (enable `bucket` in MEDINA_SOURCES):
# BUCKET_ENDPOINT=https://s3.example.com
# BUCKET_NAME=recordings
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_REGION=us-east-1
# BUCKET_FORCE_PATH_STYLE=true
# BUCKET_PREFIX=recordings/
# BUCKET_LIMIT=25
# INGEST_OWNER=  # tailscale login allowed to write (POST /in, PUT /places).
#                # Unset = writes refused with 503; reads are unaffected.
# HOME_TZ=America/Chicago  # zone for zone-less evidence and request labels
# CLUSTER_DATABASE_URL=  # shared Postgres mailbox (direct URL); checked before the wire host below
# CLUSTER_PG_WIRE_HOST=supabase-medina.int.exe.xyz  # exe wire integration; no secret needed. Unset = local SQLite via CLUSTER_DB
# CLUSTER_DB=data/cluster.db
# CLUSTER_PG_SSL=false  # only for local Postgres without TLS; hosted backends default to TLS on
# Request-path spans: `log` prints one line per finished span (name,
# duration, attributes) to the service logs; `otlp` exports OTLP/HTTP to a
# collector; `off` restores silence.
#TELEMETRY=log
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=  # full traces URL; else OTLP_ENDPOINT + /v1/traces
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_HEADERS=  # k1=v1,k2=v2 (e.g. collector auth)

{
  "name": "medina",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/index.ts",
    "./capture": "./lib/capture/index.ts",
    "./connectors": "./lib/connectors/index.ts",
    "./lifelog": "./lib/lifelog/index.ts",
    "./runtime": "./lib/runtime/index.ts"
  },
  "imports": {
    "#jsx/jsx-runtime": "./lib/jsx/jsx-runtime.ts",
    "#jsx/jsx-dev-runtime": "./lib/jsx/jsx-runtime.ts"
  },
  "scripts": {
    "build:client": "bun build ./lib/lifelog/client.ts --outfile ./example-lifelog/public/app.js --target browser --minify",
    "build:cli": "bun build ./example-lifelog/cli.ts --outfile ./example-lifelog/public/medina-cli.js --target bun --minify",
    "dev": "bun run build:client && bun run build:cli && bun --watch example-lifelog/main.ts",
    "start": "bun run build:client && bun run build:cli && bun example-lifelog/main.ts",
    "mcp:lifelog": "bun example-lifelog/mcp.ts",
    "cli:lifelog": "bun example-lifelog/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@effect/ai-openai": "^4.0.0-rc.112",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "aws4fetch": "^1.0.20",
    "effect": "4.0.0-rc.112",
    "transloadit": "^4.11.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^24",
    "typescript": "^5.9.0"
  }
}

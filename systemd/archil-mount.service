[Unit]
Description=Archil disk mounted at /mnt/archil
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
EnvironmentFile=/home/exedev/.config/archil-mount.env
ExecStartPre=/usr/bin/mkdir -p /mnt/archil
# This disk belongs to this VM. Reclaim its delegation after an unclean reboot.
ExecStart=/usr/bin/archil mount --force --region aws-us-west-2 sco@scottraymond.net/medina-dev /mnt/archil
ExecStop=/usr/bin/archil unmount /mnt/archil
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

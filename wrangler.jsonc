{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medina-rethink",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-25",
  "durable_objects": {
    "bindings": [{ "name": "STREAM", "class_name": "Stream" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stream"] }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "medina-artifacts" }],
  "workflows": [
    { "name": "medina-source-run", "binding": "SOURCE_RUN", "class_name": "SourceRun" },
    { "name": "medina-process-ingest", "binding": "PROCESS_INGEST", "class_name": "ProcessIngest" },
    { "name": "medina-assemblyai-transcript", "binding": "ASSEMBLYAI_TRANSCRIPT", "class_name": "AssemblyAITranscript" },
    { "name": "medina-journal", "binding": "JOURNAL", "class_name": "Journal" }
  ],
  "triggers": { "crons": ["0 * * * *", "30 0 * * *"] },
  "vars": {
    "GOOGLE_TOKEN_URL": "https://googlesa-sco-lifelogtest.int.exe.xyz/token",
    "ASSEMBLYAI_API_URL": "https://api.assemblyai.com",
    "GDRIVE_FOLDER_ID": "1jPV5VAlHuU-9FtGewJZPqDM5ekoKgG5q"
  }
}
